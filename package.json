{
  "name": "singularity",
  "version": "0.1.0",
  "private": true,
  "description": "AI-native backend framework: declarative intents compiled to V8-sympathetic execution units.",
  "type": "commonjs",
  "bin": {
    "singularity": "bin/singularity.js"
  },
  "scripts": {
    "check": "node bin/singularity.js check",
    "test": "node bin/singularity.js verify",
    "map": "node bin/singularity.js map",
    "drift": "node bin/singularity.js drift",
    "decisions": "node bin/singularity.js decisions",
    "layout": "node bin/singularity.js layout",
    "demo": "node examples/salon-profiler.demo.js",
    "bench": "node --expose-gc --max-old-space-size=6144 tests/benchmark.js",
    "bench:honest": "node tests/benchmark-honest.js",
    "bench:matrix": "node --expose-gc --max-old-space-size=6144 tests/benchmark-matrix.js"
  },
  "engines": {
    "node": ">=18"
  }
}
